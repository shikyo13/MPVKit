 #import <AudioToolbox/AudioToolbox.h>
 #import <AVFoundation/AVFoundation.h>
 #import <mach/mach_time.h>
+#include <stdatomic.h>
 
 struct priv {
     AudioUnit audio_unit;
     double device_latency;
+    // Observes audio route changes and media server resets (block observers).
+    id route_observer;
+    id reset_observer;
+    // Set once a reload has been requested, so the render thread asks only once.
+    atomic_bool reload_requested;
 };
+
+// Asks the core to reopen the output with the current route's format. Safe to
+// call from any thread, including the real-time render thread.
+static void request_reload(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!atomic_exchange(&p->reload_requested, true))
+        ao_request_reload(ao);
+}
+
+// True when the buffers the system handed us fit what we are about to write.
+// After an audio route change (HDMI renegotiation, AirPlay, HomePod) the unit
+// can pull with a different buffer layout than the one we configured, and
+// writing our planes into it would crash.
+static bool buffers_fit(struct ao *ao, UInt32 frames, AudioBufferList *buffer_list)
+{
+    if (!buffer_list || buffer_list->mNumberBuffers < (UInt32)ao->num_planes)
+        return false;
+    UInt32 needed = frames * ao->sstride;
+    for (int n = 0; n < ao->num_planes; n++) {
+        const AudioBuffer *buffer = &buffer_list->mBuffers[n];
+        if (!buffer->mData || buffer->mDataByteSize < needed)
+            return false;
+    }
+    return true;
+}
+
+static void output_silence(AudioUnitRenderActionFlags *aflags, AudioBufferList *buffer_list)
+{
+    if (!buffer_list)
+        return;
+    for (UInt32 n = 0; n < buffer_list->mNumberBuffers; n++) {
+        AudioBuffer *buffer = &buffer_list->mBuffers[n];
+        if (buffer->mData)
+            memset(buffer->mData, 0, buffer->mDataByteSize);
+    }
+    if (aflags)
+        *aflags |= kAudioUnitRenderAction_OutputIsSilence;
+}
 
