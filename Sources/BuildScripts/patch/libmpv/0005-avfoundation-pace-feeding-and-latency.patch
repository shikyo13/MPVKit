+// How much audio beyond the output latency is kept queued in the renderer.
+// AVSampleBufferAudioRenderer accepts far more than it needs; feeding it
+// everything mpv can decode drains mpv's buffer (underruns) and runs audio
+// decoding far ahead of video.
+#define QUEUE_AHEAD_NS (500LL * 1000 * 1000)
+// How long the feeding queue waits before checking again once enough is queued.
+#define THROTTLE_WAIT_US 10000
 
